# Normaliza todos os arquivos de texto para LF no repositório
* text=auto eol=lf

# Garante explicitamente LF nos arquivos de código/config
*.ts   text eol=lf
*.tsx  text eol=lf
*.js   text eol=lf
*.mjs  text eol=lf
*.json text eol=lf
*.md   text eol=lf
*.css  text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf
*.env* text eol=lf

# Binários — sem conversão
*.png  binary
*.jpg  binary
*.jpeg binary
*.ico  binary
*.svg  binary
